# Database
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT
# Generate a secure random secret, e.g.: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here
# Token expiry in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION=86400000

# Email (Mailtrap or any SMTP provider)
# Sign up at https://mailtrap.io to get sandbox credentials
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password

# Frontend URL — used for CORS and building invite links in emails
FRONTEND_URL=http://localhost:3000
